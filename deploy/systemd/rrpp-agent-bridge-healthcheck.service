[Unit]
Description=Check rrpp-agent-bridge production services
After=rrpp-agent-bridge-worker.service docker.service

[Service]
Type=oneshot
User=rrpp
Group=rrpp
WorkingDirectory=/opt/rrpp-agent-bridge
EnvironmentFile=/etc/rrpp-agent-bridge/rrpp.env
ExecStart=/opt/rrpp-agent-bridge/.venv/bin/rrpp-bridge healthcheck worker
ExecStart=/opt/rrpp-agent-bridge/.venv/bin/rrpp-bridge healthcheck maintenance
ExecStart=/opt/rrpp-agent-bridge/.venv/bin/rrpp-bridge healthcheck web
ExecStart=/opt/rrpp-agent-bridge/.venv/bin/rrpp-bridge healthcheck instagram
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/rrpp-agent-bridge/var
