# Production template for /etc/rrpp-agent-bridge/rrpp.env.
# Keep the real file root-owned, readable only by group rrpp, and never commit its values.
# Pass it explicitly as `--env-file /etc/rrpp-agent-bridge/rrpp.env` to production CLI checks.
RRPP_DATABASE_PATH=/opt/rrpp-agent-bridge/var/rrpp-bridge.db
RRPP_MODE=shadow
RRPP_DASHBOARD_USER=
RRPP_DASHBOARD_PASSWORD=
RRPP_SESSION_SECRET=
RRPP_HOST=127.0.0.1
RRPP_PORT=8080
RRPP_MAX_ATTEMPTS=3
RRPP_LEASE_SECONDS=60
RRPP_RESPONSE_DEBOUNCE_SECONDS=3
RRPP_CANARY_SENDERS=
RRPP_BACKUP_DIR=/opt/rrpp-agent-bridge/backups
RRPP_BACKUP_EXPORT_DIR=/opt/rrpp-agent-bridge/backup-export
RRPP_BACKUP_AGE_RECIPIENT=
RRPP_BACKUP_HOUR=3
RRPP_BACKUP_TIMEZONE=Europe/Madrid

RRPP_INSTAGRAM_ENABLED=true
RRPP_INSTAGRAM_PORT=8081
RRPP_INSTAGRAM_SEND_ENABLED=false
RRPP_INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
RRPP_INSTAGRAM_GRAPH_API_VERSION=v24.0
RRPP_INSTAGRAM_SEND_TIMEOUT_SECONDS=15
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Single-account configuration. For multiple accounts, leave these empty and
# use INSTAGRAM_ACCOUNTS_JSON plus one alias-derived token variable instead.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_ACCOUNT_ID=
INSTAGRAM_ACCOUNTS_JSON=
# INSTAGRAM_ACCOUNT_PRIMARY_ACCESS_TOKEN=
# INSTAGRAM_ACCOUNT_SECONDARY_ACCESS_TOKEN=

OPENCLAW_ENABLED=true
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_AGENT_ID=rrpp
OPENCLAW_TIMEOUT_SECONDS=60
OPENCLAW_GATEWAY_TOKEN=
